rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdminOrLeader() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'leader'];
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.role == 'member'
        && request.resource.data.membershipStatus in ['active', 'pending']
        && request.resource.data.membershipType in ['leo', 'prospective-leo']
        && request.resource.data.email is string
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.username is string
        && request.resource.data.leoId is string;

      allow get: if isOwner(userId) || isAdminOrLeader();
      allow list: if isAdminOrLeader();

      allow update: if isAdminOrLeader();

      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.role == 'member'
        && (!('leoId' in resource.data) || request.resource.data.leoId == resource.data.leoId)
        && (!('membershipType' in resource.data) || request.resource.data.membershipType == resource.data.membershipType)
        && (!('membershipStatus' in resource.data) || request.resource.data.membershipStatus == resource.data.membershipStatus);

      // Prospective members may graduate after finishing every module quiz.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.role == 'member'
        && (!('leoId' in resource.data) || request.resource.data.leoId == resource.data.leoId)
        && resource.data.membershipType == 'prospective-leo'
        && request.resource.data.membershipType == 'leo'
        && request.resource.data.trainingStatus == 'completed';

      allow update: if !signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['joiningFeePaid', 'joiningFeePaidAt', 'updatedAt'])
        && request.resource.data.joiningFeePaid == true;

      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrLeader();
    }

    match /leaders/{leaderId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrLeader();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrLeader();
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrLeader();
    }

    match /donations/{donationId} {
      allow read: if isAdminOrLeader()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (signedIn() && resource.data.donorEmail == request.auth.token.email)
        || (!signedIn() && resource.data.txRef is string);

      allow create: if request.resource.data.paymentStatus == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.donorEmail is string
        && request.resource.data.donorName is string
        && request.resource.data.txRef is string
        && request.resource.data.fiscalYear is string
        && request.resource.data.createdAt is string;

      allow update: if !signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['paymentStatus'])
        && request.resource.data.txRef == resource.data.txRef
        && request.resource.data.paymentStatus in ['completed', 'failed'];

      allow update, delete: if isAdminOrLeader();
    }

    match /donationCauses/{causeId} {
      allow read: if true;
      allow create, delete: if isAdminOrLeader();
      allow update: if isAdminOrLeader();
      allow update: if !signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['currentAmount', 'updatedAt']);
    }

    match /orders/{orderId} {
      allow read: if isAdminOrLeader()
        || (signedIn() && request.auth.uid == resource.data.userId)
        || (!signedIn() && resource.data.txRef is string);

      allow create: if request.resource.data.paymentStatus == 'pending'
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.userId is string
        && request.resource.data.txRef is string
        && request.resource.data.shippingAddress is string
        && (!signedIn() || request.auth.uid == request.resource.data.userId);

      allow update: if isAdminOrLeader();
      allow update: if !signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['paymentStatus', 'status', 'updatedAt'])
        && request.resource.data.txRef == resource.data.txRef
        && request.resource.data.paymentStatus in ['paid', 'pending', 'failed']
        && request.resource.data.status in ['pending', 'processing', 'completed', 'cancelled'];
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && request.auth.uid == resource.data.userId;
      allow create, update: if isAdminOrLeader();
      allow delete: if false;
    }

    match /membershipFees/{feeId} {
      allow read: if isAdminOrLeader()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (!signedIn() && resource.data.txRef is string);
      allow create: if isAdminOrLeader() || (
        signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['pending', 'paid']
      ) || (
        !signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.userId is string
        && request.resource.data.txRef is string
      );
      allow update: if isAdminOrLeader();
      allow update: if !signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'paymentDate'])
        && request.resource.data.txRef == resource.data.txRef
        && request.resource.data.status in ['paid', 'pending'];
      allow delete: if isAdminOrLeader();
    }

    match /trainingModules/{moduleId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdminOrLeader();
    }

    match /trainingProgress/{userId} {
      allow read: if isOwner(userId) || isAdminOrLeader();
      allow create, update: if isAdminOrLeader();
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['not_started', 'in_progress', 'completed']
        && request.resource.data.waived != true;
      allow delete: if isAdminOrLeader();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
